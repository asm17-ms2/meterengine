      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(hikaricp_connections_usage_seconds_bucket{job=\"backend\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
