          "legendFormat": "{{instance}} 활성"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (hikaricp_connections_max{job=\"backend\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} 최대"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
