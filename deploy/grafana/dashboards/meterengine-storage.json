  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "결과: 응답 시간과 오류. 무엇을 바꿀지는 아래 네 단계 중 먼저 찬 자원을 따른다. 기준값은 저장단 변화 기준 문서에 있다",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 38,
      "type": "timeseries",
      "title": "수집 API 초당 요청 수 (POST /v1/events, /v1/event-batches)",
      "description": "수집 API가 1초에 몇 번 불렸나. 같은 시간대의 처리 시간, p99, CPU 패널과 나란히 본다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 39,
      "type": "timeseries",
      "title": "수집 API 평균 처리 시간 (POST /v1/events, /v1/event-batches)",
      "description": "수집 요청 한 건을 처리하는 데 평균 몇 초 걸렸나. 왼쪽 요청 수가 늘 때 같이 느는지 본다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\"}[1m])) / sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\"}[1m]))",
          "legendFormat": "{{uri}} 평균"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "수집 API 응답 p99 (POST /v1/events, /v1/event-batches)",
      "description": "서버가 받은 뒤 저장하고 응답할 때까지. 지금 구조는 요청 안에서 저장하므로 이 값이 곧 서버 쪽 저장 지연이다. 커넥션 쥔 시간과 비교해 DB 몫이 크면 아래 2, 3단계 행을 본다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\"}[5m])))",
          "legendFormat": "{{uri}} p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\"}[5m])))",
          "legendFormat": "{{uri}} p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "수집 API 오류율 (5xx)",
      "description": "수집 요청 중 5xx 비율. 무엇을 바꿀지가 아니라 얼마나 급한지를 정한다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\",status=~\"5..\"}[5m])) or sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\"}[5m])) * 0) / sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/v1/events|/v1/event-batches\",method=\"POST\"}[5m]))",
          "legendFormat": "{{uri}} 5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "중복 응답 비율 (duplicate true)",
      "description": "200 응답 중 duplicate true 비율. 오르면 저장단이 아니라 클라이언트 재시도 쪽 문제다. 기본 키 조회가 늘어 DB CPU에 나타날 수 있다.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(meterengine_event_ingest_total{result=\"duplicate\"}[5m])) / sum(rate(meterengine_event_ingest_total{result=~\"stored|duplicate\"}[5m]))",
          "legendFormat": "duplicate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
