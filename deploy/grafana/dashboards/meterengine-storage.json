      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "900 / clamp_min(sum(increase(pg_stat_checkpointer_num_timed_total[15m])) + sum(increase(pg_stat_checkpointer_num_requested_total[15m])), 1)",
          "legendFormat": "평균 간격"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
