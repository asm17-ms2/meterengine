# 운영 리버스 프록시. 이 파일 하나가 인터넷에서 들어오는 트래픽 전부를 나눈다.
#
# 도메인을 이렇게 적어두는 것만으로 Caddy가 하는 일:
#   - Let's Encrypt에서 인증서를 자동 발급하고 만료 전에 자동 갱신한다
#   - 80으로 들어온 요청을 443으로 리다이렉트한다
#   - HTTP/2, HTTP/3를 켠다
# 그래서 인증서 관련 설정이 이 파일에 한 줄도 없다.

meterengine.com {
	# API는 백엔드로. handle_path가 아니라 handle인 이유는 경로를 그대로 넘기기 위해서다.
	# 백엔드 컨트롤러가 /v1/customers 같은 전체 경로로 매핑되어 있어, 접두사를 벗기면 404가 난다.
	handle /v1/* {
		reverse_proxy backend:8080
	}

	# 나머지는 전부 프론트엔드. Next.js가 /_next 정적 자산까지 스스로 서빙한다.
	handle {
		reverse_proxy frontend:3000
	}
}

# www로 온 요청은 정본 주소로 넘긴다. 같은 화면을 두 주소로 서빙하면 쿠키와 캐시가
# 주소마다 갈라지고, 인증을 붙일 때 도메인 설정이 두 벌이 된다.
# 이 블록도 도메인이 적혀 있으므로 www 인증서를 따로 자동 발급받는다.
www.meterengine.com {
	redir https://meterengine.com{uri} permanent
}

# 여기에 없는 것과 그 이유
#
# /actuator/*: 노출하지 않는다. 위 handle 두 개 중 뒤쪽에 걸려 프론트로 가고 404가 된다.
#   헬스체크는 배포 스크립트가 서버 안에서 127.0.0.1:8080으로 직접 부른다.
#
# email 지시어: 필수가 아니라 권장이고, 없이도 발급된다. 퍼블릭 레포라 개인 주소를
#   넣지 않았다. 인증서 만료는 MS2-168(모니터링)에서 남은 일수를 지표로 보는 쪽이 확실하다.
