# 운영 리버스 프록시. 사이트 주소만 적으면 Caddy가 인증서 발급과 HTTPS 리다이렉트를 맡는다.

{$SITE_DOMAIN} {$SITE_ALIASES} {
	@alias not host {$SITE_DOMAIN}
	redir @alias https://{$SITE_DOMAIN}{uri} permanent

	# handle_path는 접두사를 벗겨 백엔드가 404를 내므로 handle을 쓴다.
	handle /v1/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# /actuator/*는 노출하지 않는다. 헬스체크는 deploy.sh가 서버 안에서 부른다.
# email 지시어는 퍼블릭 레포라 넣지 않는다.
