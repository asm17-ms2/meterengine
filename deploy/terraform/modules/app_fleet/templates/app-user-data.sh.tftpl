#!/bin/bash
# 미리 구운 앱 서버 이미지로 떠서 설치 없이 버전 파라미터의 커밋으로 배포한다.
# 이미지에 넣을 것은 image/provision.sh가 정한다. 여기서 쓰는 도구를 늘리면 그 스크립트도 고치고 다시 굽는다.
set -euo pipefail

export AWS_REGION='${aws_region}'

# 서버 안 스크립트가 환경을 태그 대신 이 파일에서 읽는다.
install -d -m 0755 /etc/meterengine
cat >/etc/meterengine/instance.env <<'ENV'
ENVIRONMENT=${environment}
PARAMETER_PATH=${parameter_path}
APP_VERSION_PARAMETER=${app_version_parameter_name}
AWS_REGION=${aws_region}
ENV

# 아직 배포된 적 없는 환경(unset)이면 저장소를 받기 전에 실패로 끝낸다. 헬스 체크가 실패해 ASG가 서버를 바꾼다.
version=$(aws ssm get-parameter --name '${app_version_parameter_name}' --query Parameter.Value --output text)
if ! [[ "$version" =~ ^[0-9a-f]{40}$ ]]; then
  echo "버전 파라미터 값이 40자 커밋 SHA가 아니다: $version" >&2
  exit 1
fi

for tool in docker git python3; do
  if ! command -v "$tool" >/dev/null; then
    echo "서버 이미지에 $tool 명령이 없다. 시작 템플릿의 image_id가 미리 구운 앱 서버 이미지인지 본다" >&2
    exit 1
  fi
done
if ! docker compose version >/dev/null 2>&1; then
  echo "서버 이미지에 docker compose 플러그인이 없다. 시작 템플릿의 image_id가 미리 구운 앱 서버 이미지인지 본다" >&2
  exit 1
fi
systemctl enable --now docker

git clone '${repository_url}' /opt/meterengine
git -C /opt/meterengine checkout --quiet --detach "$version"
cd /opt/meterengine
./deploy/deploy.sh '${environment}' "$version"
