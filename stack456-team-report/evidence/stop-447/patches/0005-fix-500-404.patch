 .../com/meterengine/global/error/ErrorCode.java    |  1 +
 .../TossPaymentsCredentialController.java          | 10 ++++++++++
 .../service/TossPaymentsCredentialService.java     |  2 +-
 .../TossPaymentsCredentialIntegrationTest.java     | 14 ++++++++++++++
 5 files changed, 35 insertions(+), 2 deletions(-)

