             application/json:
@@ -4127,6 +4127,13 @@ paths:
             code=permission_denied: 키의 스코프나 계정의 역할로는 할 수 없는 요청이거나, 도입사가 정해지지 않은 로그인 세션이다.
             code=organization_not_active: 도입사가 활성 상태가 아니다.
             code=consent_required: 로그인 세션의 사용자가 필수 안내에 아직 동의하지 않았다. POST /v1/sessions/current/consents로 동의한다.
+        "404":
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ErrorResponse"
+          description: "code=toss_payments_credential_not_found: 경로의 mode에 저장한 키가\
+            \ 없다"
         "429":
           content:
             application/json:
@@ -5779,6 +5786,7 @@ components:
           - payment_method_not_found
           - payment_method_registration_not_found
           - payment_attempt_not_found
+          - toss_payments_credential_not_found
