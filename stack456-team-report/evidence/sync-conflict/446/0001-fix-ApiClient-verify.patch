왜
- 데모 verify는 get_billable_metric_prices(month, customer_id)와 get_price_plans(...)를 부르는데, 이 층의 ApiClient에는 인자 없는 get_billable_metric_prices만 있고 get_price_plans가 없어 verify가 실행하자마자 '예상하지 못한 오류'로 끝났다. 시험은 가짜 클라이언트를 끼워 이 실패를 잡지 못했다.

변경 사항
- get_billable_metric_prices가 month, customer_id를 받아 /v1/billable-metric-prices에 붙이고, 같은 모양의 get_price_plans로 /v1/price-plans를 부른다. #450이 같은 메서드를 같은 모양으로 더한다.

검증
- 고치기 전: core.test_api_client의 새 시험 둘이 TypeError와 AttributeError로 실패했고, 실화면 백엔드에 verify --csv를 돌리면 exit 2로 끝났다.
- 고친 뒤: python3 -m unittest discover 통과, 같은 verify가 대조까지 가서 불일치(보내지 않은 이벤트)를 보였다.
---
 demo/core/api_client.py      | 13 +++++++++++--
 demo/core/test_api_client.py | 19 +++++++++++++++++++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/demo/core/api_client.py b/demo/core/api_client.py
index 611066c0..5f145d33 100644
--- a/demo/core/api_client.py
+++ b/demo/core/api_client.py
@@ -121,8 +121,17 @@ class ApiClient:
     def get_invoice(self, month: Optional[str]) -> ApiResult:
         return self._request("GET", "/v1/invoices/draft", query=_month_query(month))
 
-    def get_billable_metric_prices(self) -> ApiResult:
-        return self._request("GET", "/v1/billable-metric-prices")
+    def get_billable_metric_prices(self, month: Optional[str] = None, customer_id: Optional[str] = None) -> ApiResult:
+        query = _month_query(month)
+        if customer_id:
+            query["customer_id"] = customer_id
+        return self._request("GET", "/v1/billable-metric-prices", query=query)
+
+    def get_price_plans(self, month: Optional[str] = None, customer_id: Optional[str] = None) -> ApiResult:
+        query = _month_query(month)
+        if customer_id:
+            query["customer_id"] = customer_id
+        return self._request("GET", "/v1/price-plans", query=query)
 
     def get_events_page(self, month: Optional[str]) -> ApiResult:
         query = _month_query(month)
diff --git a/demo/core/test_api_client.py b/demo/core/test_api_client.py
index 8e61518c..7d564bd7 100644
--- a/demo/core/test_api_client.py
+++ b/demo/core/test_api_client.py
@@ -58,6 +58,25 @@ class RecordingBackend:
         self.server.server_close()
 
 
+class PriceQueryTest(unittest.TestCase):
+    CUSTOMER_ID = "4f9d8c2e-1b7a-4c3d-9e5f-2a6b8c0d1e3f"
+
+    def backend(self):
+        made = RecordingBackend(body={})
+        self.addCleanup(made.close)
+        return made
+
+    def test_요금제_이력을_달과_고객으로_좁혀_조회한다(self):
+        backend = self.backend()
+        ApiClient(backend.base_url, LIVE_KEY).get_price_plans("2026-08", self.CUSTOMER_ID)
+        self.assertEqual(backend.requests[0][1], "/v1/price-plans?month=2026-08&customer_id=" + self.CUSTOMER_ID)
+
+    def test_미터별_가격을_달과_고객으로_좁혀_조회한다(self):
+        backend = self.backend()
+        ApiClient(backend.base_url, LIVE_KEY).get_billable_metric_prices("2026-08", self.CUSTOMER_ID)
+        self.assertEqual(backend.requests[0][1], "/v1/billable-metric-prices?month=2026-08&customer_id=" + self.CUSTOMER_ID)
+
+
 class AuthorizationHeaderTest(unittest.TestCase):
     def backend(self, status=200, body=None):
         made = RecordingBackend(status, body)
