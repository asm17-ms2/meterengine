# 이 파일은 필요한 환경변수 목록이다. 실제 값은 .env.local에 둔다 (gitignore 대상).
# 아래 값들은 lib/config.ts의 기본값과 같아서, 로컬 개발은 .env.local 없이도 돌아간다.

# 백엔드 API 주소. 서버 사이드에서만 읽는다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 - 붙이면 클라이언트 번들에 들어간다.
METERENGINE_API_BASE_URL=http://localhost:8080

# 백엔드 호출에 Authorization: Bearer로 쓰는 API 키. 이 키가 속한 도입사의 데이터를 보게 되므로 브라우저에 노출하지 않는다.
# 기본값은 backend/src/main/resources/db/local/R__local_credentials.sql의 live 키(데모 도입사, admin 스코프)다.
METERENGINE_API_KEY=me_live_QouOFuCiJyAbC0VGK1ltUCkG4IZM2LtA

# 셸 표시용 도입사 식별자. 백엔드 호출에는 쓰지 않고, API 키가 속한 도입사와 같은 값으로 맞춘다.
# 기본값은 backend/src/main/resources/db/migration/R__seed.sql의 '데모 도입사'다.
METERENGINE_ORGANIZATION_ID=d7cee55d-8c82-4afc-b996-6749d8b26a4e

# 셸 표시용 도입사 이름. 상단 바에 나온다.
METERENGINE_ORGANIZATION_NAME=데모 도입사
