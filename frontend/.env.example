# 이 파일은 필요한 환경변수 목록이다. 실제 값은 .env.local에 둔다 (gitignore 대상).
# 아래 값들은 lib/config.ts의 기본값과 같아서, 로컬 개발은 .env.local 없이도 돌아간다.

# 백엔드 API 주소. 서버 사이드에서만 읽는다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 - 붙이면 클라이언트 번들에 들어간다.
METERENGINE_API_BASE_URL=http://localhost:8080

# 조회할 도입사. backend/src/main/resources/db/migration/R__seed.sql의 '데모 도입사'다.
# 지금은 X-Organization-Id 헤더로 보내는데, 이건 MS2-126이 Bearer 인증으로 대체할
# 임시 장치다. 이 값이 어느 도입사 데이터를 볼지 정하므로 브라우저에 노출하지 않는다.
METERENGINE_ORGANIZATION_ID=d7cee55d-8c82-4afc-b996-6749d8b26a4e

# 상단 바에 표시할 도입사 이름. org 이름을 주는 엔드포인트가 아직 없어서 설정으로 받는다.
METERENGINE_ORGANIZATION_NAME=데모 도입사

# 이벤트 목록 API (GET /v1/events, MS2-131). 아직 백엔드에 없다.
# 비워 두면 프론트엔드 내장 목(src/lib/api/events.mock.ts)을 쓴다.
# MS2-131이 머지되면 주석을 풀어 METERENGINE_API_BASE_URL과 같은 값을 넣는다.
# METERENGINE_EVENTS_BASE_URL=http://localhost:8080
