# 대상이 local 하나면 키만 둔다
METERENGINE_API_KEY=
# 대상이 여럿이면 JSON 배열로 둔다. 있으면 METERENGINE_API_KEY보다 먼저 쓴다
# METERENGINE_TARGETS=[{"name":"local","base_url":"http://localhost:8080","api_key":"me_test_..."}]
# 웹훅 수신 비밀값. whsec_ + base64, 백엔드가 서명할 때 쓰는 값과 같아야 한다
METERENGINE_WEBHOOK_SECRET=
# 브리지 주소. 비우면 http://127.0.0.1:4318
METERENGINE_BRIDGE_URL=

# 공개 카드 등록 화면이 있는 제품 콘솔 주소
METERENGINE_CONSOLE_URL=http://127.0.0.1:3000
