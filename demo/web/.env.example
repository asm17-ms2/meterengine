# 단일 API 대상 local의 키
METERENGINE_API_KEY=
# 비우면 API 호출은 키의 업무 환경을 쓰고 웹훅은 기존 데이터 범위로 받는다. test나 live를 지정하면 아래 웹훅 비밀값으로 그 환경의 웹훅을 받는다
METERENGINE_ENVIRONMENT=
# 대상별 환경과 웹훅 비밀값을 JSON 배열로 둔다. 단일 대상 설정보다 먼저 쓴다. api_key는 그 environment에서 발급한 키여야 한다
# METERENGINE_TARGETS=[{"name":"local-test","base_url":"http://localhost:8080","api_key":"me_test_...","environment":"test","webhook_secret":"whsec_..."}]
# 기존 전역 웹훅 비밀값과 기록을 사용할 무환경 대상 이름만 지정한다
METERENGINE_LEGACY_WEBHOOK_TARGET=
# 위에서 지정한 기존 대상과 환경을 지정한 단일 대상에 적용한다. METERENGINE_TARGETS의 새 환경은 target의 webhook_secret을 쓴다
METERENGINE_WEBHOOK_SECRET=
# 브리지 주소. 비우면 http://127.0.0.1:4318
METERENGINE_BRIDGE_URL=

# 공개 카드 등록 화면이 있는 제품 콘솔 주소
METERENGINE_CONSOLE_URL=http://127.0.0.1:3000
